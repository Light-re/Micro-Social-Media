# Copy to application-secrets.properties (gitignored) for local overrides.
# JWT_SECRET must be at least 32 characters for HS256.
jwt.secret=replace-with-a-long-random-secret-at-least-32-chars

# Optional: enables OpenAI moderation for posts and comments.
# Never commit a real API key.
openai.api-key=replace-with-your-openai-api-key
